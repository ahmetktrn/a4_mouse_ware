<Window x:Class="MouseWare.App.UI.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MouseWare.App.Localization"
        Width="800" Height="580" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" MinWidth="100" Click="Ok_Click"
                        Content="{Binding [Editor_OK], Source={x:Static l:Loc.Instance}}" />
                <Button MinWidth="100" Margin="8,0,0,0" IsCancel="True"
                        Content="{Binding [Editor_Cancel], Source={x:Static l:Loc.Instance}}" />
            </StackPanel>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="TypeList" BorderThickness="0" DisplayMemberPath="Display" SelectionChanged="TypeList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <!-- Simple types: just an explanation -->
                    <TextBlock x:Name="PanelInfo" TextWrapping="Wrap" Visibility="Collapsed" />

                    <!-- Presets -->
                    <DockPanel x:Name="PanelPreset" Visibility="Collapsed">
                        <ListBox x:Name="PresetList" DisplayMemberPath="Display" SelectionChanged="PresetList_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,4" Foreground="{StaticResource AccentBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- Keyboard shortcut -->
                    <StackPanel x:Name="PanelKeys" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Keys_Label], Source={x:Static l:Loc.Instance}}" />
                        <DockPanel>
                            <ToggleButton x:Name="RecordButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                                          Checked="RecordButton_Checked" Unchecked="RecordButton_Unchecked"
                                          Content="{Binding [Keys_Record], Source={x:Static l:Loc.Instance}}" />
                            <TextBox x:Name="KeysBox" FontSize="16" TextChanged="KeysBox_TextChanged" />
                        </DockPanel>
                        <TextBlock x:Name="KeysError" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Keys_Special], Source={x:Static l:Loc.Instance}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="AddSpecial_Click"
                                    Content="{Binding [Keys_AddSpecial], Source={x:Static l:Loc.Instance}}" />
                            <ComboBox x:Name="SpecialKeyCombo" IsEditable="False" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="{Binding [Keys_Hold], Source={x:Static l:Loc.Instance}}" />
                    </StackPanel>

                    <!-- Mouse button -->
                    <StackPanel x:Name="PanelMouse" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Mouse_Label], Source={x:Static l:Loc.Instance}}" />
                        <ComboBox x:Name="MouseCombo" Width="280" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding [Mouse_Help], Source={x:Static l:Loc.Instance}}" />
                    </StackPanel>

                    <!-- Scroll -->
                    <StackPanel x:Name="PanelScroll" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Scroll_Direction], Source={x:Static l:Loc.Instance}}" />
                        <ComboBox x:Name="ScrollDirCombo" Width="200" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Scroll_Amount], Source={x:Static l:Loc.Instance}}" />
                        <TextBox x:Name="ScrollAmountBox" Width="80" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Run -->
                    <StackPanel x:Name="PanelRun" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Run_Path], Source={x:Static l:Loc.Instance}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click"
                                    Content="{Binding [Run_Browse], Source={x:Static l:Loc.Instance}}" />
                            <TextBox x:Name="RunPathBox" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Run_Args], Source={x:Static l:Loc.Instance}}" />
                        <TextBox x:Name="RunArgsBox" />
                    </StackPanel>

                    <!-- URL -->
                    <StackPanel x:Name="PanelUrl" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Url_Label], Source={x:Static l:Loc.Instance}}" />
                        <TextBox x:Name="UrlBox" />
                    </StackPanel>

                    <!-- Text -->
                    <DockPanel x:Name="PanelText" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Text_Label], Source={x:Static l:Loc.Instance}}" />
                        <TextBox x:Name="TypeTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    </DockPanel>

                    <!-- Window -->
                    <StackPanel x:Name="PanelWindow" Visibility="Collapsed">
                        <ComboBox x:Name="WindowCombo" Width="300" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding [Window_Label], Source={x:Static l:Loc.Instance}}" />
                    </StackPanel>

                    <!-- Macro -->
                    <DockPanel x:Name="PanelMacro" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [Macro_Label], Source={x:Static l:Loc.Instance}}" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Text="{Binding [Macro_Help], Source={x:Static l:Loc.Instance}}" />
                        <TextBlock x:Name="MacroStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="MacroBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="MacroBox_TextChanged" />
                    </DockPanel>

                    <!-- Gesture -->
                    <DockPanel x:Name="PanelGesture" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{Binding [Gesture_Help], Source={x:Static l:Loc.Instance}}" />
                        <UniformGrid x:Name="GestureGrid" Rows="3" Columns="3" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
