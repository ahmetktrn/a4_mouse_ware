<Window x:Class="MouseWare.App.UI.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MouseWare.App.Localization"
        Width="520" Height="480" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        Title="{Binding [ProfileWin_Title], Source={x:Static l:Loc.Instance}}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" MinWidth="100" Click="Ok_Click"
                        Content="{Binding [Editor_OK], Source={x:Static l:Loc.Instance}}" />
                <Button MinWidth="100" Margin="8,0,0,0" IsCancel="True"
                        Content="{Binding [Editor_Cancel], Source={x:Static l:Loc.Instance}}" />
            </StackPanel>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{Binding [ProfileWin_Name], Source={x:Static l:Loc.Instance}}" />
                    <TextBox x:Name="NameBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [ProfileWin_Running], Source={x:Static l:Loc.Instance}}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="AddRunning_Click"
                                Content="{Binding [ProfileWin_Add], Source={x:Static l:Loc.Instance}}" />
                        <ComboBox x:Name="RunningCombo" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [ProfileWin_Processes], Source={x:Static l:Loc.Instance}}" />
                </StackPanel>
                <TextBox x:Name="ProcessesBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
